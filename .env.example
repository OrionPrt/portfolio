# Copy to .env.local for local development. Never commit real values.
# Every variable is validated at startup by src/lib/env.ts (build fails fast if invalid).

# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Public base URL of the site (http/https). Optional until P3 (SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string (postgres:// or postgresql://). Needed from P3, when pages read
# the database, and by `pnpm db:migrate` / `pnpm db:seed`. Never commit a real value.
DATABASE_URL=
