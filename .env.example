# Copy to .env.local for local development. Never commit real values.
# Every variable is validated at startup by src/lib/env.ts (build fails fast if invalid).

# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Public base URL of the site (http/https). Optional until P3 (SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string (postgres:// or postgresql://) of the site's role, limited to data
# changes, as `pnpm db:roles` prints it; the admin commands use it too. Locally, one user may do for all.
DATABASE_URL=
# The owner's connection string, for `pnpm db:migrate`, `pnpm db:seed` and `pnpm db:roles` only (they
# fall back on DATABASE_URL). Never set it on Vercel. Never commit a real value of either.
DATABASE_OWNER_URL=

# Contact form (P4). All optional in development: Cloudflare's test keys, a development salt and an
# in-memory rate limit apply, and no email is sent. On Vercel, the Turnstile keys, IP_HASH_SALT and
# Upstash are required, or the form is disabled (docs/deploy.md).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# At least 32 characters, e.g. `openssl rand -base64 48`.
IP_HASH_SALT=
# Upstash Redis (or KV_REST_API_URL / KV_REST_API_TOKEN, as Vercel's integration names them).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# "Name <address>"; defaults to Portfolio <onboarding@resend.dev> until a domain is verified.
CONTACT_FROM_EMAIL=

# Admin (P5). Seals the TOTP secret (AES-256-GCM): `openssl rand -base64 32`. Optional in development
# (a public development key applies); required on Vercel, where the development key is refused, and
# for `pnpm admin:create` against Neon, with the same value as on Vercel.
TOTP_ENCRYPTION_KEY=
