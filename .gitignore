# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env example is safe to commit (no secrets)
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# IDE / local tooling
.idea/
.claude/

# local tool caches
.impeccable/

# credentials that must never be committed
.npmrc
*.key
*.p12
*.pfx

# private working documents (brief, plan, agent instructions) — kept out of the public repo
PORTFOLIO_BRIEF.md
AGENTS.md
